# =============================================================================
# Configuration de RustQuest — copie ce fichier vers ".env" et adapte-le.
#
#   cp .env.example .env
#
# ⚠️ Le fichier .env contient ton mot de passe : il NE DOIT PAS être committé
#    (il est déjà dans .gitignore).
# =============================================================================

# --- Authentification (HTTP Basic) -------------------------------------------
# Tant que ces deux variables sont remplies, l'accès est protégé par un
# identifiant + mot de passe. Laisse-les VIDES pour désactiver l'auth (local).
RUSTQUEST_AUTH_USER=valentin
# 👉 METS UN MOT DE PASSE LONG ET ALÉATOIRE. Idée pour en générer un :
#    openssl rand -base64 24
RUSTQUEST_AUTH_PASSWORD=remplace-moi-par-un-mot-de-passe-tres-long-et-aleatoire

# --- Réseau interne ----------------------------------------------------------
# Adresse d'écoute du serveur DANS le conteneur (ne pas changer pour Docker).
RUSTQUEST_BIND=0.0.0.0:3000

# --- Reverse proxy : Caddy fourni, OU le tien ? ------------------------------
# Le service Caddy (HTTPS automatique) est OPTIONNEL.
#
#   COMPOSE_PROFILES=caddy   -> on utilise le Caddy fourni (il gère le HTTPS).
#   COMPOSE_PROFILES=        -> tu as DÉJÀ un reverse proxy : Caddy est ignoré.
#                               Ton proxy enverra le trafic vers 127.0.0.1:RUSTQUEST_PORT.
COMPOSE_PROFILES=caddy

# Port publié côté hôte (utilisé par TON reverse proxy si tu n'utilises pas Caddy).
RUSTQUEST_PORT=3000

# --- HTTPS / domaine (uniquement si tu utilises le Caddy fourni) -------------
# Ton domaine pointant vers le serveur : Caddy gère le certificat HTTPS tout
# seul. Pour un test local sans domaine, mets :  RUSTQUEST_DOMAIN=:80
RUSTQUEST_DOMAIN=rustquest.exemple.fr

# E-mail pour les certificats Let's Encrypt (recommandé en production).
ACME_EMAIL=toi@exemple.fr
